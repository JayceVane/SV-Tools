{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/extension.js"
      ]
    },
    {
      "name": "Golden 格式化测试",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/test/golden_test.js",
      "cwd": "${workspaceFolder}"
    }
  ]
}
