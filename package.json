        "enablement": "!svtools.vivado.busy"
      },
      {
        "command": "svtools.vivado.tree.elaborate",
        "title": "%cmd.vivado_tree_elaborate.title%",
        "category": "SystemVerilog Tools",
        "icon": "$(checklist)",
        "enablement": "!svtools.vivado.busy"
      },
      {
        "command": "svtools.vivado.tree.synthesize",
        "title": "%cmd.vivado_tree_synthesize.title%",
        "category": "SystemVerilog Tools",
        "icon": "$(run-all)",
        "enablement": "!svtools.vivado.busy"
      },
      {
        "command": "svtools.vivado.tree.implement",
        "title": "%cmd.vivado_tree_implement.title%",
        "category": "SystemVerilog Tools",
        "icon": "$(debug-start)",
        "enablement": "!svtools.vivado.busy"
      },
      {
        "command": "svtools.vivado.tree.reportSynth",
        "title": "%cmd.vivado_tree_reportSynth.title%",
