    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "svtools-vivado",
          "title": "%viewcontainer.vivado.title%",
          "icon": "src/vivado/chip.svg"
        }
      ]
    },
    "views": {
      "svtools-vivado": [
        {
          "id": "svtools.vivado.projectTree",
          "name": "%view.vivado.projectTree.name%",
          "type": "webview"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "svtoolsWaveViewer",
        "displayName": "VCD 波形查看器",
        "selector": [
          {
            "filenamePattern": "*.vcd"
          }
        ],
        "priority": "default"
      }
    ],
    "keybindings": [
      {
        "command": "svtools.moduleInstantiation",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorLangId == verilog || editorLangId == systemverilog || editorLangId == system-verilog"
      },
      {
        "command": "svtools.generateTestbench",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "editorLangId == verilog || editorLangId == systemverilog || editorLangId == system-verilog"
      },
      {
        "command": "svtools.repeatCode",
        "key": "ctrl+f12",
        "mac": "cmd+f12",
        "when": "editorLangId == verilog || editorLangId == systemverilog || editorLangId == system-verilog"
      },
      {
        "command": "svtools.alignCode",
        "key": "ctrl+shift+x",
        "mac": "cmd+shift+x",
        "when": "editorLangId == verilog || editorLangId == systemverilog || editorLangId == system-verilog"
      },
      {
        "command": "svtools.insertHeader",
        "key": "ctrl+shift+insert",
        "mac": "cmd+shift+insert",
        "when": "editorLangId == verilog || editorLangId == systemverilog || editorLangId == system-verilog"
      }
    ],
    "submenus": [
      {
        "id": "svtools.submenu",
        "label": "SystemVerilog Tools"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "svtools.iverilog.waveformFromText",
          "group": "navigation",
          "when": "resourceExtname == .vcd && !activeCustomEditorId"
        },
        {
          "command": "svtools.iverilog.showText",
          "group": "navigation",
          "when": "activeCustomEditorId == svtoolsWaveViewer"
        },
        {
          "command": "svtools.simulate.pick",
          "alt": "svtools.vivado.simulate",
          "group": "navigation@0",
          "when": "(resourceExtname == .sv || resourceExtname == .v || resourceExtname == .svh || resourceExtname == .vh) && activeCustomEditorId != svtoolsWaveViewer"
        },
        {
          "command": "svtools.xvlog.elaborate",
          "group": "navigation@1",
          "when": "config.svtools.lint.engine == 'xvlog' && (resourceExtname == .sv || resourceExtname == .v || resourceExtname == .svh || resourceExtname == .vh) && activeCustomEditorId != svtoolsWaveViewer"
        },
        {
          "command": "svtools.iverilog.stopSimulation",
          "group": "navigation@2",
          "when": "svtools.simRunning && activeCustomEditorId != svtoolsWaveViewer"
        },
        {
          "command": "svtools.vivado.reports",
          "group": "navigation@3",
          "when": "(resourceExtname == .sv || resourceExtname == .v || resourceExtname == .svh || resourceExtname == .vh) && activeCustomEditorId != svtoolsWaveViewer"
        },
        {
          "command": "svtools.vivado.addToFileset",
          "alt": "svtools.vivado.removeFromFileset",
          "group": "navigation@1",
          "when": "(resourceExtname == .sv || resourceExtname == .v || resourceExtname == .svh || resourceExtname == .vh) && svtools.vivado.hasProject"
        },
        {
          "command": "svtools.vivado.runActiveScript",
          "alt": "svtools.vivado.runScript",
          "group": "navigation@0",
          "when": "resourceExtname == .tcl"
        },
        {
          "command": "svtools.circuit.fromSource",
          "when": "resourceScheme == file && (editorLangId == verilog || editorLangId == systemverilog || editorLangId == system-verilog)",
          "group": "navigation@4"
        }
      ],
      "view/title": [
        {
          "command": "svtools.circuit.fromVivado",
          "group": "circuit@1",
          "when": "view == svtools.vivado.projectTree && svtools.vivado.hasProject && !svtools.vivado.busy"
        },
        {
          "command": "svtools.project.choose",
          "group": "navigation@1",
          "when": "view == svtools.vivado.projectTree"
        },
        {
          "command": "svtools.project.refresh",
          "group": "navigation@2",
          "when": "view == svtools.vivado.projectTree"
        },
        {
          "command": "svtools.vivado.tree.stop",
          "group": "navigation@3",
          "when": "view == svtools.vivado.projectTree && svtools.vivado.busy"
        }
      ],
      "editor/context": [
        {
          "command": "svtools.circuit.open",
          "when": "resourceScheme == file && resourceExtname =~ /\\.json$/i",
          "group": "9_svtools"
        },
        {
          "command": "svtools.formatDocument",
          "when": "editorLangId == verilog || editorLangId == systemverilog || editorLangId == system-verilog",
          "group": "1_modification"
        },
        {
          "submenu": "svtools.submenu",
          "when": "editorLangId == verilog || editorLangId == systemverilog || editorLangId == system-verilog",
          "group": "2_modification"
        },
        {
          "command": "svtools.vivado.runActiveScript",
          "when": "resourceExtname == .tcl",
          "group": "9_svtools"
        },
        {
          "command": "svtools.circuit.traceDrivers",
          "group": "5_circuit_trace@1",
          "when": "resourceScheme == file && resourceExtname =~ /\\.(sv|v)$/i"
        },
        {
          "command": "svtools.circuit.traceLoads",
          "group": "5_circuit_trace@2",
          "when": "resourceScheme == file && resourceExtname =~ /\\.(sv|v)$/i"
        },
        {
          "command": "svtools.project.trace",
          "group": "svtools@15",
          "when": "editorLangId == verilog || editorLangId == systemverilog || editorLangId == system-verilog"
        }
      ],
      "svtools.submenu": [
        {
          "command": "svtools.moduleInstantiation",
          "group": "1_gadget"
        },
        {
          "command": "svtools.generateTestbench",
          "group": "1_gadget"
        },
        {
          "command": "svtools.repeatCode",
          "group": "2_gadget"
        },
        {
          "command": "svtools.alignCode",
          "group": "2_gadget"
        },
        {
          "command": "svtools.insertHeader",
          "group": "3_gadget"
        },
        {
          "command": "svtools.iverilog.lint",
          "group": "4_simulation"
        },
        {
          "command": "svtools.iverilog.simulate",
          "group": "4_simulation"
        },
        {
          "command": "svtools.iverilog.stopSimulation",
          "group": "4_simulation"
        },
        {
          "command": "svtools.iverilog.openWaveform",
          "group": "4_simulation"
        },
        {
          "command": "svtools.circuit.fromSource",
          "when": "resourceScheme == file && resourceExtname =~ /\\.(sv|v)$/i",
          "group": "5_circuit"
        },
        {
          "command": "svtools.circuit.fromVivadoFile",
          "group": "5_circuit",
          "when": "resourceScheme == file && resourceExtname =~ /\\.(sv|v)$/i"
        },
        {
          "command": "svtools.circuit.stop",
          "group": "5_circuit"
        }
      ],
      "explorer/context": [
        {
          "command": "svtools.project.addToProject",
          "group": "svtools@1",
          "when": "resourceScheme == file && (explorerResourceIsFolder || resourceExtname =~ /\\.(sv|v|svh|vh)$/i)"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "svtools.project.traceTrigger": {
          "type": "string",
          "enum": [
            "selection",
