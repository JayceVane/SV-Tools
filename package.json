      },
      {
        "command": "svtools.circuit.traceLoads",
        "title": "%cmd.circuit.traceLoads.title%",
        "category": "SystemVerilog Tools",
        "icon": "$(references)"
      },
      {
        "command": "svtools.project.choose",
        "title": "%cmd.project.choose.title%",
