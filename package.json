      },
      {
        "command": "svtools.vivado.tree.reportImpl",
        "title": "%cmd.vivado_tree_reportImpl.title%",
        "category": "SystemVerilog Tools",
        "icon": "$(watch)",
        "enablement": "!svtools.vivado.busy"
      },
      {
        "command": "svtools.vivado.tree.reportImplUtil",
        "title": "%cmd.vivado_tree_reportImplUtil.title%",
        "category": "SystemVerilog Tools",
        "icon": "$(list-tree)",
        "enablement": "!svtools.vivado.busy"
      },
      {
        "command": "svtools.vivado.tree.reportTiming",
        "title": "%cmd.vivado_tree_reportTiming.title%",
        "category": "SystemVerilog Tools",
        "icon": "$(watch)",
        "enablement": "!svtools.vivado.busy"
      },
      {
        "command": "svtools.vivado.tree.bitstream",
        "title": "%cmd.vivado_tree_bitstream.title%",
        "category": "SystemVerilog Tools",
        "icon": "$(package)",
