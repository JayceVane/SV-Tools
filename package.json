{
  "name": "svtools",
  "displayName": "SystemVerilog Tools",
  "description": "Verilog/SystemVerilog formatter, module instantiation, testbench generation, and productivity tools (Rust native backend)",
  "version": "3.4.2-beta6",
  "publisher": "JayceVane",
  "author": {
    "name": "JayceVane",
    "email": "JayceVane@163.com"
  },
  "license": "Apache-2.0",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#007ACC",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JayceVane/SV-Tools"
  },
  "bugs": {
    "url": "https://github.com/JayceVane/SV-Tools/issues"
  },
  "homepage": "https://github.com/JayceVane/SV-Tools",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Formatters",
    "Snippets"
  ],
  "keywords": [
    "systemverilog",
    "verilog",
    "formatter",
    "format",
    "align",
    "hdl",
    "fpga",
    "testbench",
    "module instantiation",
    "硬件描述语言",
    "SystemVerilog",
    "Verilog"
  ],
  "activationEvents": [
    "onLanguage:verilog",
    "onLanguage:systemverilog"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "verilog",
        "aliases": [
          "Verilog",
          "verilog"
        ],
        "extensions": [
          ".v",
          ".vh"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "systemverilog",
        "aliases": [
          "SystemVerilog",
          "System Verilog",
          "sv"
        ],
        "extensions": [
          ".sv",
          ".svh"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "systemverilog",
        "scopeName": "source.systemverilog",
        "path": "./syntaxes/systemverilog.tmLanguage.json"
      },
      {
        "language": "verilog",
        "scopeName": "source.systemverilog",
        "path": "./syntaxes/systemverilog.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "svtools.formatDocument",
        "title": "Format Document",
        "category": "SystemVerilog Tools"
      },
      {
        "command": "svtools.moduleInstantiation",
        "title": "Generate Module Instantiation",
        "category": "SystemVerilog Tools",
        "icon": "icon.png"
      },
      {
        "command": "svtools.generateTestbench",
        "title": "Generate Testbench",
        "category": "SystemVerilog Tools"
      },
      {
        "command": "svtools.repeatCode",
        "title": "Repeat Code with Numbers",
        "category": "SystemVerilog Tools"
      },
      {
        "command": "svtools.alignCode",
        "title": "Align Selected Code",
        "category": "SystemVerilog Tools"
      },
      {
        "command": "svtools.insertHeader",
        "title": "Insert File Header",
        "category": "SystemVerilog Tools"
      },
      {
        "command": "svtools.iverilog.lint",
        "title": "Icarus Verilog: Lint Current File",
        "category": "SystemVerilog Tools",
        "icon": "$(search)"
      },
      {
        "command": "svtools.iverilog.simulate",
        "title": "Icarus Verilog: Run Simulation",
        "category": "SystemVerilog Tools",
        "icon": "$(play)"
      },
      {
        "command": "svtools.iverilog.stopSimulation",
        "title": "Icarus Verilog: Stop Simulation",
        "category": "SystemVerilog Tools",
        "icon": "$(debug-stop)"
      },
      {
        "command": "svtools.iverilog.openWaveform",
        "title": "Icarus Verilog: Open VCD Waveform Viewer",
        "category": "SystemVerilog Tools",
        "icon": "$(pulse)"
      },
      {
        "command": "svtools.iverilog.waveformFromText",
        "title": "VCD: Open as Waveform",
        "category": "SystemVerilog Tools",
        "icon": "$(pulse)"
      },
      {
        "command": "svtools.iverilog.showText",
        "title": "VCD: Show as Text",
        "category": "SystemVerilog Tools",
        "icon": "$(go-to-file)"
      }
    ],
    "customEditors": [
      {
        "viewType": "svtoolsWaveViewer",
        "displayName": "VCD 波形查看器",
        "selector": [
          {
            "filenamePattern": "*.vcd"
          }
        ],
        "priority": "option"
      }
    ],
    "keybindings": [
      {
        "command": "svtools.moduleInstantiation",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorLangId == verilog || editorLangId == systemverilog || editorLangId == system-verilog"
      },
      {
        "command": "svtools.generateTestbench",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "editorLangId == verilog || editorLangId == systemverilog || editorLangId == system-verilog"
      },
      {
        "command": "svtools.repeatCode",
        "key": "ctrl+f12",
        "mac": "cmd+f12",
        "when": "editorLangId == verilog || editorLangId == systemverilog || editorLangId == system-verilog"
      },
      {
        "command": "svtools.alignCode",
        "key": "ctrl+shift+x",
        "mac": "cmd+shift+x",
        "when": "editorLangId == verilog || editorLangId == systemverilog || editorLangId == system-verilog"
      },
      {
        "command": "svtools.insertHeader",
        "key": "ctrl+shift+insert",
        "mac": "cmd+shift+insert",
        "when": "editorLangId == verilog || editorLangId == systemverilog || editorLangId == system-verilog"
      }
    ],
    "submenus": [
      {
        "id": "svtools.submenu",
        "label": "SystemVerilog Tools"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "svtools.iverilog.waveformFromText",
          "group": "navigation",
          "when": "resourceExtname == .vcd && !activeCustomEditorId"
        },
        {
          "command": "svtools.iverilog.showText",
          "group": "navigation",
          "when": "activeCustomEditorId == svtoolsWaveViewer"
        }
      ],
      "editor/context": [
        {
          "command": "svtools.formatDocument",
          "when": "editorLangId == verilog || editorLangId == systemverilog || editorLangId == system-verilog",
          "group": "1_modification"
        },
        {
          "submenu": "svtools.submenu",
          "when": "editorLangId == verilog || editorLangId == systemverilog || editorLangId == system-verilog",
          "group": "2_modification"
        }
      ],
      "svtools.submenu": [
        {
          "command": "svtools.moduleInstantiation",
          "group": "1_gadget"
        },
        {
          "command": "svtools.generateTestbench",
          "group": "1_gadget"
        },
        {
          "command": "svtools.repeatCode",
          "group": "2_gadget"
        },
        {
          "command": "svtools.alignCode",
          "group": "2_gadget"
        },
        {
          "command": "svtools.insertHeader",
          "group": "3_gadget"
        },
        {
          "command": "svtools.iverilog.lint",
          "group": "4_simulation"
        },
        {
          "command": "svtools.iverilog.simulate",
          "group": "4_simulation"
        },
        {
          "command": "svtools.iverilog.stopSimulation",
          "group": "4_simulation"
        },
        {
          "command": "svtools.iverilog.openWaveform",
          "group": "4_simulation"
        }
      ]
    },
    "configuration": {
      "title": "SystemVerilog Tools",
      "properties": {
        "svtools.tabSize": {
          "type": "number",
          "default": 4,
          "description": "Number of spaces for indentation"
        },
        "svtools.useTab": {
          "type": "boolean",
          "default": false,
          "description": "Use tab for indentation"
        },
        "svtools.oneBindPerLine": {
          "type": "boolean",
          "default": true,
          "description": "One port binding per line in module instance"
        },
        "svtools.oneDeclPerLine": {
          "type": "boolean",
          "default": false,
          "description": "One signal declaration per line"
        },
        "svtools.paramOneLine": {
          "type": "boolean",
          "default": true,
          "description": "Keep parameters on one line if possible"
        },
        "svtools.indentStyle": {
          "type": "string",
          "enum": [
            "1tbs",
            "gnu"
          ],
          "default": "1tbs",
          "description": "Indentation style"
        },
        "svtools.stripEmptyLine": {
          "type": "boolean",
          "default": true,
          "description": "Strip empty lines"
        },
        "svtools.maxConsecutiveEmptyLines": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 10,
          "description": "Maximum number of consecutive empty lines allowed (0 = remove all empty lines)"
        },
        "svtools.instAlignPort": {
          "type": "boolean",
          "default": true,
          "description": "Align instance ports"
        },
        "svtools.ignoreTick": {
          "type": "boolean",
          "default": true,
          "description": "Ignore preprocessor directives for indentation"
        },
        "svtools.importSameLine": {
          "type": "boolean",
          "default": false,
          "description": "Keep import on same line as module declaration"
        },
        "svtools.alignComma": {
          "type": "boolean",
          "default": true,
          "description": "Align comma/semicolon"
        },
        "svtools.instPrefix": {
          "type": "string",
          "default": "u_",
          "description": "Default prefix for module instance name"
        },
        "svtools.includePortDeclarations": {
          "type": "boolean",
          "default": true,
          "description": "Include signal declarations when generating module instantiation (input->reg, output->wire)"
        },
        "svtools.reset": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Default asynchronous reset signal names"
        },
        "svtools.sreset": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Default synchronous reset signal names"
        },
        "svtools.clock": {
          "type": "array",
          "default": [
            "clk",
            "uclk",
            "cclk"
          ],
          "items": {
            "type": "string"
          },
          "description": "Default clock signal names"
        },
        "svtools.waveType": {
          "type": "string",
          "enum": [
            "fsdb",
            "vpd",
            "shm",
            "vcd"
          ],
          "default": "fsdb",
          "description": "Type of waveform dump"
        },
        "svtools.taskInit": {
          "type": "boolean",
          "default": true,
          "description": "Generate init task in testbench"
        },
        "svtools.taskDrive": {
          "type": "boolean",
          "default": true,
          "description": "Generate drive task in testbench"
        },
        "svtools.headerTemplate": {
          "type": "string",
          "default": "",
          "description": "Header template with placeholders: {FILE}, {DATE}, {TIME}, {YEAR}, {TABS}"
        },
        "svtools.iverilog.path": {
          "type": "string",
          "default": "",
          "description": "Icarus Verilog bin directory (or full path to iverilog executable). Empty = auto-detect from IVERILOG_HOME, PATH and common install locations."
        },
        "svtools.iverilog.cygwinPath": {
          "type": "string",
          "default": "",
          "description": "Directory containing cygwin1.dll, required by Cygwin builds of Icarus Verilog installed outside a Cygwin root. Empty = auto-detect."
        },
        "svtools.iverilog.lintOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run iverilog syntax check on save and report diagnostics in the Problems panel"
        },
        "svtools.iverilog.scanWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Scan the workspace for Verilog sources: add every directory containing them to -y/-I, and resolve missing modules by indexing module definitions (handles files whose name differs from the module name)"
        },
        "svtools.iverilog.lintOnChange": {
          "type": "boolean",
          "default": true,
          "description": "Run iverilog syntax check while typing (debounced, lints the unsaved buffer via a temp file)"
        },
        "svtools.iverilog.lintDebounceMs": {
          "type": "number",
          "default": 800,
          "minimum": 100,
          "description": "Debounce delay in milliseconds for lint-on-type"
        },
        "svtools.iverilog.lintOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Run iverilog syntax check when a Verilog file is opened"
        },
        "svtools.iverilog.standard": {
          "type": "string",
          "enum": [
            "auto",
            "default",
            "1995",
            "2001",
            "2005",
            "2005-sv",
            "2009",
            "2012"
          ],
          "default": "auto",
          "description": "Language standard passed as -g. auto: .sv/.svh use 2012, .v/.vh use 2005; default: let iverilog decide"
        },
        "svtools.iverilog.lintArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-Wall"
          ],
          "description": "Extra iverilog arguments for lint and simulation compile (e.g. -Wall)"
        },
        "svtools.iverilog.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Include directories (-I), relative to the workspace root. The file's own directory is always included."
        },
        "svtools.iverilog.libraryPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Library directories (-y) for module-by-filename resolution, relative to the workspace root. The file's own directory is always included."
        },
        "svtools.iverilog.simFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Glob patterns of extra source files compiled together with the active file during simulation (e.g. src/*.v, tb/*.sv)"
        },
        "svtools.iverilog.simTop": {
          "type": "string",
          "default": "",
          "description": "Top module for simulation (-s). Empty = let iverilog pick the root module"
        },
        "svtools.iverilog.simArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments passed to vvp at runtime (e.g. plusargs like +trace)"
        },
        "svtools.iverilog.simTimeoutMs": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Simulation timeout in milliseconds; 0 = run until $finish (stop via command or status bar)"
        },
        "svtools.iverilog.waveViewer": {
          "type": "string",
          "default": "",
          "description": "External waveform viewer executable (e.g. GTKWave). Empty = use the built-in VCD waveform viewer (webview panel; external program is used for .fst files)"
        },
        "svtools.iverilog.autoOpenWaveform": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the built-in waveform viewer when a simulation produces a new .vcd file"
        }
      }
    }
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.9.1"
  }
}
