        "category": "SystemVerilog Tools",
        "icon": "$(arrow-up)",
        "enablement": "!svtools.vivado.busy"
      },
      {
        "command": "svtools.vivado.tree.moveToSim",
        "title": "%cmd.vivado_tree_moveToSim.title%",
