{
  "name": "svtools",
  "displayName": "SystemVerilog Tools",
  "description": "Verilog/SystemVerilog formatter, module instantiation, testbench generation, and productivity tools (Rust native backend)",
  "version": "3.4.6-beta1",
  "publisher": "JayceVane",
  "author": {
    "name": "JayceVane",
    "email": "JayceVane@163.com"
  },
  "license": "Apache-2.0",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#007ACC",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JayceVane/SV-Tools"
  },
  "bugs": {
    "url": "https://github.com/JayceVane/SV-Tools/issues"
  },
  "homepage": "https://github.com/JayceVane/SV-Tools",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Formatters",
    "Snippets"
  ],
  "keywords": [
    "systemverilog",
    "verilog",
    "formatter",
    "format",
    "align",
    "hdl",
    "fpga",
    "testbench",
    "module instantiation",
    "硬件描述语言",
    "SystemVerilog",
    "Verilog"
  ],
  "activationEvents": [
    "onLanguage:verilog",
    "onLanguage:systemverilog"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "verilog",
        "aliases": [
          "Verilog",
          "verilog"
        ],
        "extensions": [
          ".v",
          ".vh"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "systemverilog",
        "aliases": [
          "SystemVerilog",
          "System Verilog",
          "sv"
        ],
        "extensions": [
          ".sv",
          ".svh"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "systemverilog",
        "scopeName": "source.systemverilog",
        "path": "./syntaxes/systemverilog.tmLanguage.json"
      },
      {
        "language": "verilog",
        "scopeName": "source.systemverilog",
        "path": "./syntaxes/systemverilog.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "svtools.formatDocument",
        "title": "%cmd.formatDocument.title%",
        "category": "SystemVerilog Tools"
      },
      {
        "command": "svtools.moduleInstantiation",
        "title": "%cmd.moduleInstantiation.title%",
        "category": "SystemVerilog Tools",
        "icon": "icon.png"
      },
      {
        "command": "svtools.generateTestbench",
        "title": "%cmd.generateTestbench.title%",
        "category": "SystemVerilog Tools"
      },
      {
        "command": "svtools.repeatCode",
        "title": "%cmd.repeatCode.title%",
        "category": "SystemVerilog Tools"
      },
      {
        "command": "svtools.alignCode",
        "title": "%cmd.alignCode.title%",
        "category": "SystemVerilog Tools"
      },
      {
        "command": "svtools.insertHeader",
        "title": "%cmd.insertHeader.title%",
        "category": "SystemVerilog Tools"
      },
      {
        "command": "svtools.iverilog.lint",
        "title": "%cmd.iverilog_lint.title%",
        "category": "SystemVerilog Tools",
        "icon": "$(search)"
      },
      {
        "command": "svtools.iverilog.simulate",
        "title": "%cmd.iverilog_simulate.title%",
        "category": "SystemVerilog Tools",
        "icon": "$(play)"
      },
      {
        "command": "svtools.iverilog.stopSimulation",
        "title": "%cmd.iverilog_stopSimulation.title%",
        "category": "SystemVerilog Tools",
        "icon": "$(debug-stop)"
      },
      {
        "command": "svtools.iverilog.openWaveform",
        "title": "%cmd.iverilog_openWaveform.title%",
        "category": "SystemVerilog Tools",
        "icon": "$(pulse)"
      },
      {
        "command": "svtools.iverilog.waveformFromText",
        "title": "%cmd.iverilog_waveformFromText.title%",
        "category": "SystemVerilog Tools",
        "icon": "$(pulse)"
      },
      {
        "command": "svtools.iverilog.showText",
        "title": "%cmd.iverilog_showText.title%",
        "category": "SystemVerilog Tools",
        "icon": "$(go-to-file)"
      },
      {
        "command": "svtools.vivado.runScript",
        "title": "%cmd.vivado_runScript.title%",
        "category": "SystemVerilog Tools"
      },
      {
        "command": "svtools.vivado.runActiveScript",
        "title": "%cmd.vivado_runActiveScript.title%",
        "category": "SystemVerilog Tools",
        "icon": "$(play)"
      },
      {
        "command": "svtools.vivado.stop",
        "title": "%cmd.vivado_stop.title%",
        "category": "SystemVerilog Tools"
      },
      {
        "command": "svtools.vivado.createProject",
        "title": "%cmd.vivado_createProject.title%",
        "category": "SystemVerilog Tools"
      },
      {
        "command": "svtools.vivado.addToFileset",
        "title": "%cmd.vivado_addToFileset.title%",
        "category": "SystemVerilog Tools",
        "icon": "$(add)"
      },
      {
        "command": "svtools.vivado.removeFromFileset",
        "title": "%cmd.vivado_removeFromFileset.title%",
        "category": "SystemVerilog Tools",
        "icon": "$(remove)"
      },
      {
        "command": "svtools.vivado.simulate",
        "title": "%cmd.vivado_simulate.title%",
        "category": "SystemVerilog Tools",
        "icon": "$(play)"
      },
      {
        "command": "svtools.simulate.pick",
        "title": "%cmd.simulate_pick.title%",
        "category": "SystemVerilog Tools",
        "icon": "$(play)"
      }
    ],
    "customEditors": [
      {
        "viewType": "svtoolsWaveViewer",
        "displayName": "VCD 波形查看器",
        "selector": [
          {
            "filenamePattern": "*.vcd"
          }
        ],
        "priority": "option"
      }
    ],
    "keybindings": [
      {
        "command": "svtools.moduleInstantiation",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorLangId == verilog || editorLangId == systemverilog || editorLangId == system-verilog"
      },
      {
        "command": "svtools.generateTestbench",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "editorLangId == verilog || editorLangId == systemverilog || editorLangId == system-verilog"
      },
      {
        "command": "svtools.repeatCode",
        "key": "ctrl+f12",
        "mac": "cmd+f12",
        "when": "editorLangId == verilog || editorLangId == systemverilog || editorLangId == system-verilog"
      },
      {
        "command": "svtools.alignCode",
        "key": "ctrl+shift+x",
        "mac": "cmd+shift+x",
        "when": "editorLangId == verilog || editorLangId == systemverilog || editorLangId == system-verilog"
      },
      {
        "command": "svtools.insertHeader",
        "key": "ctrl+shift+insert",
        "mac": "cmd+shift+insert",
        "when": "editorLangId == verilog || editorLangId == systemverilog || editorLangId == system-verilog"
      }
    ],
    "submenus": [
      {
        "id": "svtools.submenu",
        "label": "SystemVerilog Tools"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "svtools.iverilog.waveformFromText",
          "group": "navigation",
          "when": "resourceExtname == .vcd && !activeCustomEditorId"
        },
        {
          "command": "svtools.iverilog.showText",
          "group": "navigation",
          "when": "activeCustomEditorId == svtoolsWaveViewer"
        },
        {
          "command": "svtools.simulate.pick",
          "alt": "svtools.vivado.simulate",
          "group": "navigation@0",
          "when": "(resourceExtname == .sv || resourceExtname == .v || resourceExtname == .svh || resourceExtname == .vh) && activeCustomEditorId != svtoolsWaveViewer"
        },
        {
          "command": "svtools.vivado.addToFileset",
          "alt": "svtools.vivado.removeFromFileset",
          "group": "navigation@1",
          "when": "(resourceExtname == .sv || resourceExtname == .v || resourceExtname == .svh || resourceExtname == .vh) && svtools.vivado.hasProject"
        },
        {
          "command": "svtools.vivado.runActiveScript",
          "alt": "svtools.vivado.runScript",
          "group": "navigation@0",
          "when": "resourceExtname == .tcl"
        }
      ],
      "editor/context": [
        {
          "command": "svtools.formatDocument",
          "when": "editorLangId == verilog || editorLangId == systemverilog || editorLangId == system-verilog",
          "group": "1_modification"
        },
        {
          "submenu": "svtools.submenu",
          "when": "editorLangId == verilog || editorLangId == systemverilog || editorLangId == system-verilog",
          "group": "2_modification"
        },
        {
          "command": "svtools.vivado.runActiveScript",
          "when": "resourceExtname == .tcl",
          "group": "9_svtools"
        }
      ],
      "svtools.submenu": [
        {
          "command": "svtools.moduleInstantiation",
          "group": "1_gadget"
        },
        {
          "command": "svtools.generateTestbench",
          "group": "1_gadget"
        },
        {
          "command": "svtools.repeatCode",
          "group": "2_gadget"
        },
        {
          "command": "svtools.alignCode",
          "group": "2_gadget"
        },
        {
          "command": "svtools.insertHeader",
          "group": "3_gadget"
        },
        {
          "command": "svtools.iverilog.lint",
          "group": "4_simulation"
        },
        {
          "command": "svtools.iverilog.simulate",
          "group": "4_simulation"
        },
        {
          "command": "svtools.iverilog.stopSimulation",
          "group": "4_simulation"
        },
        {
          "command": "svtools.iverilog.openWaveform",
          "group": "4_simulation"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "svtools.tabSize": {
          "type": "number",
          "default": 4,
          "description": "%cfg.tabSize.desc%"
        },
        "svtools.useTab": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.useTab.desc%"
        },
        "svtools.oneBindPerLine": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.oneBindPerLine.desc%"
        },
        "svtools.oneDeclPerLine": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.oneDeclPerLine.desc%"
        },
        "svtools.paramOneLine": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.paramOneLine.desc%"
        },
        "svtools.indentStyle": {
          "type": "string",
          "enum": [
            "1tbs",
            "gnu"
          ],
          "default": "1tbs",
          "description": "%cfg.indentStyle.desc%"
        },
        "svtools.stripEmptyLine": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.stripEmptyLine.desc%"
        },
        "svtools.maxConsecutiveEmptyLines": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 10,
          "description": "%cfg.maxConsecutiveEmptyLines.desc%"
        },
        "svtools.instAlignPort": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.instAlignPort.desc%"
        },
        "svtools.ignoreTick": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.ignoreTick.desc%"
        },
        "svtools.importSameLine": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.importSameLine.desc%"
        },
        "svtools.alignComma": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.alignComma.desc%"
        },
        "svtools.instPrefix": {
          "type": "string",
          "default": "u_",
          "description": "%cfg.instPrefix.desc%"
        },
        "svtools.includePortDeclarations": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.includePortDeclarations.desc%"
        },
        "svtools.reset": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "%cfg.reset.desc%"
        },
        "svtools.sreset": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "%cfg.sreset.desc%"
        },
        "svtools.clock": {
          "type": "array",
          "default": [
            "clk",
            "uclk",
            "cclk"
          ],
          "items": {
            "type": "string"
          },
          "description": "%cfg.clock.desc%"
        },
        "svtools.waveType": {
          "type": "string",
          "enum": [
            "fsdb",
            "vpd",
            "shm",
            "vcd"
          ],
          "default": "fsdb",
          "description": "%cfg.waveType.desc%"
        },
        "svtools.taskInit": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.taskInit.desc%"
        },
        "svtools.taskDrive": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.taskDrive.desc%"
        },
        "svtools.headerTemplate": {
          "type": "string",
          "default": "",
          "description": "%cfg.headerTemplate.desc%"
        },
        "svtools.iverilog.path": {
          "type": "string",
          "default": "",
          "description": "%cfg.iverilog_path.desc%"
        },
        "svtools.iverilog.cygwinPath": {
          "type": "string",
          "default": "",
          "description": "%cfg.iverilog_cygwinPath.desc%"
        },
        "svtools.iverilog.lintOnSave": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.iverilog_lintOnSave.desc%"
        },
        "svtools.iverilog.scanWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.iverilog_scanWorkspace.desc%"
        },
        "svtools.iverilog.lintOnChange": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.iverilog_lintOnChange.desc%"
        },
        "svtools.iverilog.lintDebounceMs": {
          "type": "number",
          "default": 800,
          "minimum": 100,
          "description": "%cfg.iverilog_lintDebounceMs.desc%"
        },
        "svtools.iverilog.lintOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.iverilog_lintOnOpen.desc%"
        },
        "svtools.iverilog.standard": {
          "type": "string",
          "enum": [
            "auto",
            "default",
            "1995",
            "2001",
            "2005",
            "2005-sv",
            "2009",
            "2012"
          ],
          "default": "auto",
          "description": "%cfg.iverilog_standard.desc%"
        },
        "svtools.iverilog.lintArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-Wall"
          ],
          "description": "%cfg.iverilog_lintArgs.desc%"
        },
        "svtools.iverilog.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%cfg.iverilog_includePaths.desc%"
        },
        "svtools.iverilog.libraryPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%cfg.iverilog_libraryPaths.desc%"
        },
        "svtools.iverilog.simFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%cfg.iverilog_simFiles.desc%"
        },
        "svtools.iverilog.simTop": {
          "type": "string",
          "default": "",
          "description": "%cfg.iverilog_simTop.desc%"
        },
        "svtools.iverilog.simArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%cfg.iverilog_simArgs.desc%"
        },
        "svtools.iverilog.simTimeoutMs": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%cfg.iverilog_simTimeoutMs.desc%"
        },
        "svtools.iverilog.waveViewer": {
          "type": "string",
          "default": "",
          "description": "%cfg.iverilog_waveViewer.desc%"
        },
        "svtools.iverilog.autoOpenWaveform": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.iverilog_autoOpenWaveform.desc%"
        },
        "svtools.vivado.path": {
          "type": "string",
          "default": "",
          "description": "%cfg.vivado_path.desc%"
        },
        "svtools.vivado.part": {
          "type": "string",
          "default": "",
          "description": "%cfg.vivado_part.desc%"
        },
        "svtools.vivado.timeoutMs": {
          "type": "number",
          "default": 0,
          "description": "%cfg.vivado_timeoutMs.desc%"
        },
        "svtools.vivado.structure": {
          "type": "object",
          "default": {
            "sources": [
              "src",
              "rtl",
              "rtl/**",
              "src/**"
            ],
            "sim": [
              "sim",
              "tb",
              "sim/**",
              "tb/**"
            ],
            "constraints": [
              "constraints",
              "xdc",
              "constraints/**",
              "xdc/**",
              "*.xdc"
            ],
            "projectDir": "prj"
          },
          "description": "%cfg.vivado_structure.desc%",
          "properties": {
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "%cfg.vivado_structure_sources.desc%"
            },
            "sim": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "%cfg.vivado_structure_sim.desc%"
            },
            "constraints": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "%cfg.vivado_structure_constraints.desc%"
            },
            "projectDir": {
              "type": "string",
              "description": "%cfg.vivado_structure_projectDir.desc%"
            }
          }
        },
        "svtools.vivado.simRuntime": {
          "type": "string",
          "default": "",
          "description": "%cfg.vivado_simRuntime.desc%"
        }
      }
    }
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.9.1"
  }
}
