{
  "name": "svtools",
  "displayName": "SystemVerilog Tools",
  "description": "Verilog/SystemVerilog formatter, module instantiation, testbench generation, and productivity tools (Rust native backend)",
  "version": "4.1.0",
  "publisher": "JayceVane",
  "author": {
    "name": "JayceVane",
    "email": "JayceVane@163.com"
  },
  "license": "Apache-2.0",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#007ACC",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JayceVane/SV-Tools"
  },
  "bugs": {
    "url": "https://github.com/JayceVane/SV-Tools/issues"
  },
  "homepage": "https://github.com/JayceVane/SV-Tools",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Formatters",
    "Snippets"
  ],
  "keywords": [
    "systemverilog",
    "verilog",
    "formatter",
    "format",
    "align",
    "hdl",
    "fpga",
    "testbench",
    "module instantiation",
    "硬件描述语言",
    "SystemVerilog",
    "Verilog"
  ],
  "activationEvents": [
    "onLanguage:verilog",
    "onLanguage:systemverilog"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "npm run check && node test/golden_test.js && npm run build:circuit && node --test test/task_retention_test.js test/public_package_test.js test/highlighting_test.js test/simulation_engines_test.js test/formatter_semantics_test.js test/codegen_release_test.js test/waveform_lifecycle_test.js test/module_inst_test.js test/formatter_contract_test.js test/formatter_conservation_test.js test/toolchain_test.js test/waveform_test.js test/editor_test.js test/workspace_test.js test/source_catalog_test.js test/project_manager_test.js test/project_signal_flow_test.js test/project_rtl_test.js test/project_trace_context_test.js test/project_flow_controller_test.js test/project_view_test.js test/project_client_test.js test/waveform_stream_test.js test/waveform_ui_test.js test/waveform_signal_test.js test/waveform_layout_test.js test/image_export_test.js test/export_file_safety_test.js test/waveform_host_test.js test/waveform_memory_test.js test/waveform_memory_view_test.js test/waveform_float_test.js test/waveform_interaction_test.js test/waveform_renderer_test.js test/waveform_row_layout_test.js test/waveform_row_gesture_test.js test/waveform_column_layout_test.js test/waveform_column_resize_test.js test/waveform_column_client_test.js test/waveform_time_scrollbar_test.js test/waveform_circuit_link_test.js test/debug_wave_mapping_test.js test/debug_cursor_values_test.js test/process_output_test.js test/toolchain_task_test.js test/lint_diagnostics_test.js test/vivado_tree_test.js test/vivado_xpr_test.js test/vivado_commands_test.js test/vivado_task_layout_test.js test/completion_syntax_test.js test/completion_catalog_test.js test/completion_engine_test.js test/completion_index_test.js test/completion_provider_test.js && node scripts/test-circuit.js",
    "build:native": "node scripts/build-native.js",
    "package": "vsce package",
    "package:preview": "node scripts/package-preview.js",
    "vscode:prepublish": "npm test && node scripts/check-public-package.js",
    "check": "node scripts/check-js.js",
    "test:retention": "node --test test/task_retention_test.js",
    "build:circuit": "node scripts/build-circuit-assets.js",
    "test:circuit": "npm run build:circuit && node scripts/test-circuit.js"
  },
  "contributes": {
    "languages": [
      {
        "id": "verilog",
        "aliases": [
          "Verilog",
          "verilog"
        ],
        "extensions": [
          ".v",
          ".vh"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "systemverilog",
        "aliases": [
          "SystemVerilog",
          "System Verilog",
          "sv"
        ],
        "extensions": [
          ".sv",
          ".svh"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "systemverilog",
        "scopeName": "source.systemverilog",
        "path": "./syntaxes/systemverilog.tmLanguage.json"
      },
      {
        "language": "verilog",
        "scopeName": "source.systemverilog",
        "path": "./syntaxes/systemverilog.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "svtools.formatDocument",
        "title": "%cmd.formatDocument.title%",
        "category": "SystemVerilog Tools"
      },
      {
        "command": "svtools.moduleInstantiation",
        "title": "%cmd.moduleInstantiation.title%",
        "category": "SystemVerilog Tools",
        "icon": "icon.png"
      },
      {
        "command": "svtools.generateTestbench",
        "title": "%cmd.generateTestbench.title%",
        "category": "SystemVerilog Tools"
      },
      {
        "command": "svtools.repeatCode",
        "title": "%cmd.repeatCode.title%",
        "category": "SystemVerilog Tools"
      },
      {
        "command": "svtools.alignCode",
        "title": "%cmd.alignCode.title%",
        "category": "SystemVerilog Tools"
      },
      {
        "command": "svtools.insertHeader",
        "title": "%cmd.insertHeader.title%",
        "category": "SystemVerilog Tools"
      },
      {
        "command": "svtools.iverilog.lint",
        "title": "%cmd.iverilog_lint.title%",
        "category": "SystemVerilog Tools",
        "icon": "$(search)"
      },
      {
        "command": "svtools.lint.selectEngine",
        "title": "%cmd.lint_selectEngine.title%",
        "category": "SystemVerilog Tools",
        "icon": "$(zap)"
      },
      {
        "command": "svtools.xvlog.elaborate",
        "title": "%cmd.xvlog_elaborate.title%",
