      },
      {
        "command": "svtools.project.create",
        "title": "%cmd.project.create.title%",
        "category": "SV Tools",
        "icon": "$(new-folder)"
      },
      {
        "command": "svtools.project.add",
        "title": "%cmd.project.add.title%",
        "category": "SV Tools",
        "icon": "$(add)"
      },
      {
        "command": "svtools.project.addToProject",
        "title": "%cmd.project.addToProject.title%",
        "category": "SV Tools",
        "icon": "$(add)"
      },
      {
        "command": "svtools.project.trace",
        "title": "%cmd.project.trace.title%",
        "category": "SV Tools",
        "icon": "$(references)"
