{
  "name": "svtools-native",
  "version": "3.0.1",
  "description": "SystemVerilog formatter and tools native addon",
  "main": "index.js",
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm"
  },
  "napi": {
    "name": "svtools",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "aarch64-apple-darwin",
        "aarch64-linux-android"
      ]
    }
  },
  "keywords": ["verilog", "systemverilog", "formatter", "napi-rs"],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  }
}
